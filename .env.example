# GLaDOS 自动签到 - 本地配置模板
#
# 用法:
#   1. 复制本文件为 .env   (Linux: cp .env.example .env)
#   2. 填入你的 GLADOS_COOKIES (其余可选, 留空即可)
#   3. 运行一键脚本:  ./run-local.sh  (Windows: .\run-local.ps1)
#
# 说明: .env 已被 .gitignore 忽略, 你的 cookie 不会泄露到 Git。

# [必需] 账号列表, 固定 JSON 数组；每项可含 name / origin / cookie / user-agent
# 获取方式: 在 GLaDOS 签到页面按 F12 -> 切到 Network -> 刷新 ->
#           点第一个请求 -> 在 Request Headers 里找 Cookie / User-Agent -> 复制其值
# 示例 (单行即可, 也可换行书写):
#   GLADOS_COOKIES=[{"name":"主号","origin":"glados.cloud","cookie":"koa:sess=...; koa:sess.sig=...","user-agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) ..."}]
# 说明:
#   - cookie 必填; name / origin / user-agent 可省略
#   - origin 不填则自动探测所属域名; 各站 cookie 通常不互通, 填错会自动回退全部候选域名
#   - 仍兼容旧版 `&` 分隔格式, 但会提示尽快迁移为 JSON
GLADOS_COOKIES=[{"cookie":"koa:sess=你的cookie; koa:sess.sig=你的签名"}]

# [可选] 自动兑换积分策略: plan100(100分/10天) / plan200(200分/30天) / plan500(500分/100天)
#         留空 = 不自动兑换 (默认)
GLADOS_EXCHANGE_PLAN=

# [可选] PushDeer 推送 key (获取: https://www.pushdeer.com/product.html)
#         留空 = 不发送手机推送
PUSHDEER_SENDKEY=

# [可选] Server酱 推送 SendKey (获取: https://sct.ftqq.com/)
#         留空 = 不发送
SERVERCHAN_SENDKEY=

# [可选] 是否输出详细日志: true / false (默认 false)
GLADOS_VERBOSE=false
