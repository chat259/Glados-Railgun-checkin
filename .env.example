# GLaDOS 自动签到 - 本地配置模板
#
# 用法:
#   1. 复制本文件为 .env   (Linux: cp .env.example .env)
#   2. 填入你的 GLADOS_COOKIES (其余可选, 留空即可)
#   3. 运行一键脚本:  ./run-local.sh  (Windows: .\run-local.ps1)
#
# 说明: .env 已被 .gitignore 忽略, 你的 cookie 不会泄露到 Git。

# [必需] GLaDOS 账号的有效 cookie
# 获取方式: 在 GLaDOS 签到页面按 F12 -> 切到 Network -> 刷新 ->
#           点第一个请求 -> 在 Request Headers 里找 Cookie -> 右键复制其值
# 参考格式: koa:sess=eyJ...; koa:sess.sig=xJkO...
#
# 多账号写法 (二选一):
#   A. 单行: GLADOS_COOKIES=c1&c2&c3
#   B. 多行: GLADOS_COOKIES= 后跟若干行, 每行一个 cookie (推荐, 不超行)
GLADOS_COOKIES=koa:sess=你的cookie; koa:sess.sig=你的签名
# gld:sess=gld_...; gld:sess.sig=...

# [可选] 自动兑换积分策略: plan100(100分/10天) / plan200(200分/30天) / plan500(500分/100天)
#         留空 = 不自动兑换 (默认)
GLADOS_EXCHANGE_PLAN=

# [可选] PushDeer 推送 key (获取: https://www.pushdeer.com/product.html)
#         留空 = 不发送手机推送
PUSHDEER_SENDKEY=

# [可选] 是否输出详细日志: true / false (默认 false)
GLADOS_VERBOSE=true
